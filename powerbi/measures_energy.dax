// Energy grid measures — paste into Power BI DAX (Modeling → New measure)
Avg Utilization % = AVERAGE ( energy_hourly[utilization_pct] )
Peak Utilization % = MAX ( energy_hourly[utilization_pct] )
Peak-to-Avg Ratio = DIVIDE ( MAX ( energy_hourly[cable_flow_mw] ), AVERAGE ( energy_hourly[cable_flow_mw] ) )
Overload Hours = CALCULATE ( COUNTROWS ( energy_hourly ), energy_hourly[utilization_pct] > 100 )
Near-Capacity Hours = CALCULATE ( COUNTROWS ( energy_hourly ), energy_hourly[utilization_pct] > 90 )
Cables Near Capacity = DISTINCTCOUNT ( rpt_peak_to_avg[cable_id] ) // filtered >90 via visual filter
Stress Index = SUM ( rpt_stress_nodes[high_load_hours] ) + 3 * SUM ( rpt_stress_nodes[overload_hours] )
Storm Stress Hours = CALCULATE ( COUNTROWS ( energy_hourly ), energy_hourly[storm] = TRUE, energy_hourly[utilization_pct] > 90 )
Util Band =
    SWITCH ( TRUE (),
        energy_hourly[utilization_pct] < 50, "<50%",
        energy_hourly[utilization_pct] < 75, "50-75%",
        energy_hourly[utilization_pct] < 90, "75-90%",
        energy_hourly[utilization_pct] <= 100, "90-100%",
        ">100% (overload)" )
